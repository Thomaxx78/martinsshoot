# Public OAuth client ID from Google Cloud > Google Auth platform > Clients.
# Never put a Google password or OAuth client secret here.
VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
VITE_MARTIN_GOOGLE_EMAIL=martin@example.com

# Vercel server environment variables (never prefix these with VITE_).
# Generate GOOGLE_SESSION_SECRET with: openssl rand -base64 32
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=from-google-cloud-oauth-web-client
GOOGLE_SESSION_SECRET=base64-encoded-32-random-bytes
MARTIN_GOOGLE_EMAIL=martin@example.com
